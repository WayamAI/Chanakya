# Copy to .env. Never commit .env.
OLLAMA_API_KEY=
# Agent reasoning model. For Qwen Max set the exact tag your Ollama Cloud account lists, then run
#   python scripts/chanakya.py llm-check
OLLAMA_MODEL=
# Optional second model. Used ONLY if OLLAMA_ALLOW_FALLBACK=true (no silent model switch).
OLLAMA_FALLBACK_MODEL=
OLLAMA_ALLOW_FALLBACK=false
OLLAMA_HOST=https://ollama.com
OLLAMA_TIMEOUT_S=180
OLLAMA_MAX_RETRIES=2
CHANAKYA_DB_PATH=data/chanakya.db
# Phase 2 (Clay MCP) - filled in once discovery is implemented
CLAY_MCP_URL=
# Pinned Clay workspace (kri's Workspace). Live searches refuse to run against any other workspace.
CLAY_WORKSPACE_ID=1461095
# Agent 4 (LinkedIn Resolver): path to a local checkout of Mriganka's LinkedIn harness. Unset = dry runs only.
LINKEDIN_HARNESS_DIR=
LINKEDIN_HARNESS_TIMEOUT_S=300
# Only if you don't use uv, e.g. ".venv\Scripts\python linkedin_harness.py" (run inside LINKEDIN_HARNESS_DIR)
LINKEDIN_HARNESS_CMD=
# Agent 7 sync targets, ';'-separated: csv:PATH | xlsx:PATH | jsonl:PATH | webhook:URL (webhook only with --live)
CHANAKYA_SYNC_TARGETS=
# Agent 5 PAID Clay email lookup. Empty = off. "Reviewer Name|reason|max_records (<=5)"
CHANAKYA_PAID_EMAIL_APPROVAL=
# Sign-off used in outreach drafts
CHANAKYA_SENDER=

# Claude (Opus / Sonnet / Haiku routing: src/chanakya/llm/routing.py)
ANTHROPIC_API_KEY=
# Qwen Max, Chanakya's main agent model: Alibaba Cloud Model Studio (DashScope), OpenAI-compatible endpoint
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-max
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# Outlook via the Wayam-owned Chanakya Entra app (docs/OUTLOOK_ENTRA_APP.md). Used automatically once the client ID
# and a valid tenant GUID are set; OUTLOOK_PROVIDER=mcp forces the Softeria route.
CHANAKYA_MS_CLIENT_ID=
CHANAKYA_MS_TENANT_ID=
CHANAKYA_MS_REDIRECT_URI=http://localhost:3000/auth/callback
# Web platform registration: a client secret is required to redeem the code on the backend (never commit it)
CHANAKYA_MS_CLIENT_SECRET=

# Lakshya handover folder (contains 03_Research/lakshya_seed_all.json). Refreshed by the signal_sweep stage and
# by POST /api/intel/lakshya/import.
LAKSHYA_DIR=
